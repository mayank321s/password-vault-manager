# ==============================================================================
# ENVIRONMENT CONFIGURATION - ZERO-KNOWLEDGE PASSWORD MANAGER
# ==============================================================================
# IMPORTANT: This file contains configuration examples.
# Copy this to .env.local and fill in with your actual values.
# NEVER commit .env.local to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=api

# ------------------------------------------------------------------------------
# Frontend URL (for CORS)
# ------------------------------------------------------------------------------
# SECURITY: Only whitelist your actual frontend origin
# Production example: https://app.yourpasswordmanager.com
# Never use wildcards (*) in production!
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=password_manager
DATABASE_USER=postgres
# SECURITY: Use a strong database password (20+ characters, mixed case, numbers, symbols)
DATABASE_PASSWORD=your_secure_database_password_here_change_in_production
DATABASE_SSL=false
# SECURITY: Set to true in production to encrypt database connections
DATABASE_LOGGING=false
# SECURITY: Never enable logging in production (may log sensitive queries)

# ------------------------------------------------------------------------------
# JWT Configuration
# ------------------------------------------------------------------------------
# SECURITY: Generate strong random secrets using crypto.randomBytes(32).toString('hex')
# CRITICAL: These must be 256-bit (32 bytes) minimum
# Example command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_very_long_random_jwt_secret_key_here_minimum_256_bits_required
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_very_long_random_refresh_token_secret_here_minimum_256_bits
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# Argon2 Configuration
# ------------------------------------------------------------------------------
# SECURITY: Server-side salt for password hashing
# CRITICAL: This must be unique per deployment and NEVER changed after initial setup
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Changing this will invalidate all existing user passwords!
ARGON2_SERVER_SALT=your_unique_server_salt_here_minimum_256_bits_never_change_after_deployment

# ------------------------------------------------------------------------------
# TOTP Configuration
# ------------------------------------------------------------------------------
# SECURITY: 256-bit AES-GCM key used to encrypt TOTP secrets at rest in the database
# CRITICAL: Must be exactly 64 hex characters (32 bytes). NEVER change after initial setup.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=your_64_character_hex_string_here_generate_with_crypto_randombytes_32

# ------------------------------------------------------------------------------
# Rate Limiting / Throttling
# ------------------------------------------------------------------------------
# General API rate limits
THROTTLE_TTL=60
# Default: 100 requests per minute per IP
THROTTLE_LIMIT=100

# Authentication endpoint specific limits (stricter)
AUTH_THROTTLE_TTL=900
# Default: 5 login attempts per 15 minutes per IP
AUTH_THROTTLE_LIMIT=5

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Log levels: error, warn, info, http, verbose, debug, silly
# SECURITY: Use 'info' in production, 'debug' only in development
LOG_LEVEL=info
LOG_FILE_PATH=./logs
# SECURITY: Logs automatically redact passwords, tokens, and encryption keys
# Files are rotated at 5MB with 5 backups retained

# ------------------------------------------------------------------------------
# Security Features
# ------------------------------------------------------------------------------
# Enable Helmet security headers (XSS protection, frame options, etc.)
HELMET_ENABLED=true
# Enable CORS with strict origin checking
CORS_ENABLED=true

# ==============================================================================
# SECURITY CHECKLIST FOR PRODUCTION:
# ==============================================================================
# [ ] All secrets are strong random values (256-bit minimum)
# [ ] ARGON2_SERVER_SALT is unique and will NEVER be changed
# [ ] DATABASE_SSL is set to true
# [ ] DATABASE_LOGGING is set to false
# [ ] FRONTEND_URL is set to your actual production domain
# [ ] NODE_ENV is set to 'production'
# [ ] LOG_LEVEL is set to 'info' or 'warn'
# [ ] .env.local is NOT committed to git (.gitignore is configured)
# [ ] Database password uses 20+ characters with mixed complexity
# [ ] Rate limits are configured appropriately for your traffic
# ==============================================================================
